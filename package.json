{
  "name": "@sjawhar/opencode-knives",
  "version": "0.15.0",
  "description": "OpenCode plugin for knives, the multi-fork multi-agent maintenance tool.",
  "type": "module",
  "main": "plugin/knives.ts",
  "types": "plugin/knives.ts",
  "exports": {
    ".": "./plugin/knives.ts"
  },
  "omp": {
    "extensions": [
      "./omp/extensions/knives.ts"
    ]
  },
  "files": [
    "plugin/knives.ts",
    "plugin/lib/",
    "skills/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sjawhar/knives"
  },
  "license": "MIT",
  "scripts": {
    "test:knives-plugin": "bun test plugin/knives.test.ts",
    "typecheck": "tsc --noEmit -p plugin",
    "typecheck:omp": "tsc --noEmit -p omp",
    "lint": "biome check --error-on-warnings biome.jsonc package.json plugin/ omp/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@oh-my-pi/pi-coding-agent": "17.3.4",
    "@types/bun": "1.3.13",
    "typescript": "5.8.2"
  }
}
